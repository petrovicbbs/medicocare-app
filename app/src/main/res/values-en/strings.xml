    <string name="premium_barcode_dialog_title">Barcode scanning — Premium</string>
    <string name="premium_barcode_dialog_text">Barcode scanning and searching/filtering by barcode are Premium features. Real subscription sales aren\'t enabled yet — for now you can temporarily unlock all Premium features for testing.</string>

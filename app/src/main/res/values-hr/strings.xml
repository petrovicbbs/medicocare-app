    <string name="premium_barcode_dialog_title">Skeniranje barkoda — Premium</string>
    <string name="premium_barcode_dialog_text">Skeniranje barkoda i pretraga/filtriranje po barkodu su Premium funkcije. Prava prodaja pretplate još nije uključena — za sada možeš privremeno otključati sve Premium funkcije radi testiranja.</string>
